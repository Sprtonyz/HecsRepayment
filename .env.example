# Optional live market and AI features
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_NEWS_ANALYSIS_MODE=testing
# Automatic monthly report model. Daily collection does not call a model.
OPENAI_MONTHLY_NEWS_MODEL=gpt-5.5

# Optional shared sync for review bundles and tracker setup
# Preferred: SUPABASE_SECRET_KEY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional protection for the shared "Review Latest" and review-publish endpoints
SHARED_REVIEW_TOKEN=

# Required for the protected Vercel Cron routes.
CRON_SECRET=
# Comma-separated ticker registry override; defaults to AAPL,NVDA,AMZN,TSLA,SPCX.
DEEP_CONTEXT_NEWS_SYMBOLS=AAPL,NVDA,AMZN,TSLA,SPCX

# Local helpers for pulling and publishing shared review bundles
REVIEW_SOURCE_URL=https://hecs-repayment.vercel.app
